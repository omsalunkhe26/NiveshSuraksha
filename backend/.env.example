# MoneyGuard Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# AI Provider Configuration (Options: "gemini", "openai", "demo")
# If no key is provided, MoneyGuard automatically runs in resilient Demo Mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./moneyguard.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
